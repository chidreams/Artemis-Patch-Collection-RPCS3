PPU-f0618d75a06af4bd5df8c1499ccc0cc5dbc0acd5:
  "Weapon Modifier":
    Games:
      "RESIDENT EVIL THE UMBRELLA CHRONICLES (Artemis)":
        NPUB30650: [ 01.00]
    Author: bungholio Ported by ChiDreams
    Notes: The displayed weapon name will be different than what you are actually using. This code will change your weapon type so you can use any type.
    Patch Version: 1.2
    Patch:
      - [ load, *RESIDENTEVILTUC5 ]
# The weapons are ordered like this
# 0000 = Samurai Edge 2
# 0001 = Assault Shotgun
# 0002 = Submachine Gun
# 0003 = Unknown
# 0004 = MRL
# 0005 = Hand Grenade
# 0006 = Nothing
# 0007 = Grenade Launcher
# 0008 = Magnum Revolver
# 0009 = Shotgun
# 000A = Automatic Pistol
# 000B = Grenade Launcher AT
# 000C = Magnum AT
# 000D = Rocket Launcher
# 000E = Shotgun SA
# 000F = Submachine Gun HP
# 0010 = Grenade Launcher HP
# 0011 = Hand Cannon
# 0012 = Anti-tank Gun
# 0013 = Unknown
# 0014 = Unknown
