# Title: Devil May Cry 4
# Serial: BLUS30092
# Category: DG
# Version: APP_VER=01.01 VERSION=01.01
# Localized Title: Devil May Cry 4      
Anchors:
  Game_Speed_Values: &Game_Speed_Values
    "Game Speed":
      Type: long_enum
      Value: &default_game_speed 0x3FA00000
      Allowed Values:
        "0.5x": 0x3F000000
        "0.75x": 0x3F400000
        "1.25x": *default_game_speed
        "1.5x": 0x3FC00000

  Movement_Speed_Values: &Movement_Speed_Values
    "Movement Speed":
      Type: long_enum
      Value: &default_move_speed 0x3FA00000
      Allowed Values:
        "1.25x": *default_move_speed
        "1.5x": 0x3FC00000
        "1.75x": 0x3FE00000
        "2x": 0x40000000
        "3x": 0x40400000
        "4x": 0x40800000

