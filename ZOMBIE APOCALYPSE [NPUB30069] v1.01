Anchors:
  Zombie_Speed_Values: &Zombie_Speed_Values
    "Game Speed":
      Type: long_enum
      Value: &normal_speed 0x3F800000
      Allowed Values:
        "0.5x": 0x3F000000
        "0.75x": 0x3F400000
        "0.875x": 0x3F600000
        "0.9375x": 0x3F700000
        "Normal": *normal_speed
        "1.25x": 0x3FA00000
        "1.5x": 0x3FC00000
        "1.75x": 0x3FE00000
        "2x": 0x40000000
        "2.5x": 0x40200000
        "3x": 0x40400000
        "4x": 0x40800000
        "5x": 0x40A00000

  Zombie_Camera_Values: &Zombie_Camera_Values
    "Camera Distance":
      Type: long_enum
      Value: &normal_cam 0x3F800000
      Allowed Values:
        "0x": 0x00000000
        "0.5x": 0x3F000000
        "0.75x": 0x3F400000
        "0.875x": 0x3F600000
        "Normal": *normal_cam
        "1.25x": 0x3FA00000
        "1.5x": 0x3FC00000
        "1.75x": 0x3FE00000
        "2x": 0x40000000
        "3x": 0x40400000
        "4x": 0x40800000
        "5x": 0x40A00000

  Zombie_Kill_Values: &Zombie_Kill_Values
    "Kill Multiplier":
      Type: long_enum
      Value: &normal_kill 0x39290001
      Allowed Values:
        "Normal": *normal_kill
        "10x": 0x3929000A
        "100x": 0x39290064
        "1000x": 0x392903E8
        "10000x": 0x39292710

